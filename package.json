{
  "name": "smebuddy-clone",
  "version": "0.1.0",
  "private": true,
  "description": "AI 智能体桌面工作台（SMEbuddy 风格）",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-venv.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "backend:test": "backend/.venv/Scripts/python.exe -m pytest backend/tests",
    "backend:build": "node scripts/build-backend.mjs",
    "package:win": "npm run build && npm run backend:build && electron-builder --win --config",
    "package:mac": "npm run build && npm run backend:build && electron-builder --mac --config"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.22.2",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
